# ==============================================================================
# Home Lab Setup - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# CREDENTIALS & SECRETS (NEVER COMMIT!)
# ------------------------------------------------------------------------------
PASSWORDS.md
github_credentials.md
/working/
/ddns/
/proxmox/credentials
/proxmox/nas_credentials
# SMB password file read by www/scripts/setup_smb_mount.sh (GitHub-ignored, GitLab-mirrored)
/www/scripts/smb_credentials
*.pem
*.key
*.crt
*.pfx
*.p12
.env
.env.*

# ------------------------------------------------------------------------------
# LARGE BINARY FILES (ISOs & Archives)
# ------------------------------------------------------------------------------
*.iso
*.zip

# ------------------------------------------------------------------------------
# SYSTEM & EDITOR FILES
# ------------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp

# ------------------------------------------------------------------------------
# EDUCATION PROGRAM
# ------------------------------------------------------------------------------
# Every study track gets its own scratch/ — throwaway variants used to capture
# reproducible output for the chapters, research dumps, and the highlight anchor
# lists. The chapters quote the results; the scratch copies are not the artefact.
education/*/scratch/

# Andrew's paste-runner (his idea, Aug 18 2026). Rather than paste a multi-line block
# into an interactive shell — which is how BOTH mispaste incidents happened, because
# later lines land in the input buffer while ssh is still connecting — he pastes into
# this file and executes it. One process reads it start to finish; nothing can steal
# the lines. The TECHNIQUE is documented in education/docker-swarm/COMMANDS.md; the
# file's CONTENTS are different every time and are not an artefact.
education/*/scripts/run_commands.sh

# ------------------------------------------------------------------------------
# PYTHON
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]

# ------------------------------------------------------------------------------
# LOGS & TEMPORARY FILES
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.cache

# ------------------------------------------------------------------------------
# END OF .gitignore
# ------------------------------------------------------------------------------

