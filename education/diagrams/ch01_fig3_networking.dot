// Chapter 1, Figure 3 — The three networks and how a Service finds Pods
// Render: dot -Tpng -Gdpi=150 ch01_fig3_networking.dot -o ../images/ch01_fig3_networking.png
digraph networking {
  rankdir=TB;
  bgcolor="white";
  compound=true;
  nodesep=0.35;
  ranksep=0.55;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="filled,rounded", height=0.6];
  edge [fontname="DejaVu Sans", fontsize=9];

  subgraph cluster_lan {
    label=<<B>1. YOUR LAN — 192.168.1.0/24</B>     real addresses on real network interfaces>;
    labeljust="l"; fontsize=12; margin=14;
    style="filled,rounded"; fillcolor="#fff2cc"; color="#bf8f00"; penwidth=2;

    laptop  [label="Your Z8 workstation", fillcolor="#ffffff", color="#bf8f00"];
    node186 [label="Node: vm-k8-redpanda-1\n192.168.1.186", fillcolor="#ffffff", color="#bf8f00"];
    {rank=same; laptop; node186;}
    laptop -> node186 [label="  kubectl → API server :6443"];
  }

  subgraph cluster_svc {
    label=<<B>2. SERVICE NETWORK — 10.43.0.0/16</B>     VIRTUAL: no interface owns these, they are iptables rules>;
    labeljust="l"; fontsize=12; margin=14;
    style="filled,rounded"; fillcolor="#deebf7"; color="#1f4e79"; penwidth=2;

    svc_k8s [label="kubernetes\n10.43.0.1", fillcolor="#ffffff", color="#1f4e79"];
    svc_dns [label="kube-dns (CoreDNS)\n10.43.0.10", fillcolor="#ffffff", color="#1f4e79"];
    svc_app [label="my-app   type: ClusterIP\n10.43.12.7\nSTABLE — never changes", fillcolor="#bdd7ee", color="#1f4e79", penwidth=2];
    {rank=same; svc_k8s; svc_dns; svc_app;}
  }

  subgraph cluster_pod {
    label=<<B>3. POD NETWORK — 10.42.0.0/16</B>     real IPs from flannel, but EPHEMERAL: a new pod gets a new IP>;
    labeljust="l"; fontsize=12; margin=14;
    style="filled,rounded"; fillcolor="#e2efda"; color="#548235"; penwidth=2;

    pod_dns [label="coredns\n10.42.0.4", fillcolor="#ffffff", color="#548235"];
    pod_trf [label="traefik\n10.42.0.8", fillcolor="#ffffff", color="#548235"];
    pod_a   [label="my-app-7d4f-abc12\n10.42.0.21\nlabel: app=my-app", fillcolor="#c6e0b4", color="#548235"];
    pod_b   [label="my-app-7d4f-xy890\n10.42.0.22\nlabel: app=my-app", fillcolor="#c6e0b4", color="#548235"];
    {rank=same; pod_dns; pod_trf; pod_a; pod_b;}
  }

  node186 -> svc_k8s [lhead=cluster_svc, color="#bf8f00", penwidth=2, minlen=1];
  svc_dns -> pod_dns [style=dashed, color="#888888", label="  backed by"];
  svc_app -> pod_a [label="selector\napp=my-app", color="#548235", penwidth=2, fontcolor="#548235"];
  svc_app -> pod_b [color="#548235", penwidth=2];

  flow [shape=note, style="filled", fillcolor="#f2f2f2", color="#666666", fontsize=10, margin=0.25, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3">
      <TR><TD ALIGN="LEFT"><B>HOW ONE POD REACHES ANOTHER — the reason Services exist</B></TD></TR>
      <TR><TD ALIGN="LEFT"> </TD></TR>
      <TR><TD ALIGN="LEFT"><B>1.</B>  Your code connects to a NAME:   my-app.default.svc.cluster.local</TD></TR>
      <TR><TD ALIGN="LEFT"><B>2.</B>  CoreDNS answers with the Service's stable virtual IP:   10.43.12.7</TD></TR>
      <TR><TD ALIGN="LEFT"><B>3.</B>  kube-proxy's iptables rules rewrite that VIP to ONE of the pod IPs</TD></TR>
      <TR><TD ALIGN="LEFT">      behind it — 10.42.0.21 or 10.42.0.22. That is the load balancing.</TD></TR>
      <TR><TD ALIGN="LEFT"><B>4.</B>  Traffic arrives at a real container.</TD></TR>
      <TR><TD ALIGN="LEFT"> </TD></TR>
      <TR><TD ALIGN="LEFT"><B>WHY IT MATTERS:</B> pod IPs change constantly. Delete a pod and its replacement</TD></TR>
      <TR><TD ALIGN="LEFT">gets a different IP. Nothing can ever hardcode a pod IP. The Service name is</TD></TR>
      <TR><TD ALIGN="LEFT">the stable thing you build against — and it is how Redpanda brokers, your</TD></TR>
      <TR><TD ALIGN="LEFT">producer, and your consumer will all find each other later.</TD></TR>
    </TABLE>
  >];

  pod_a -> flow [style=invis];
}
