// Chapter 1, Figure 6 — What a PersistentVolume actually is on this cluster
// Render: dot -Tpng -Gdpi=150 ch01_fig6_storage_stack.dot -o ../images/ch01_fig6_storage_stack.png
digraph storage {
  rankdir=TB;
  bgcolor="white";
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];

  layers [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9">
      <TR><TD COLSPAN="2" BGCOLOR="#1f4e79"><FONT COLOR="white" POINT-SIZE="12"><B>ONE FILE, SIX LAYERS DOWN — where /data/notes.txt really lives</B></FONT></TD></TR>

      <TR>
        <TD BGCOLOR="#c6e0b4" ALIGN="LEFT"><B>What the pod sees</B></TD>
        <TD BGCOLOR="#e2efda" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="DejaVu Sans Mono">/data/notes.txt</FONT><BR/><FONT POINT-SIZE="9">The container believes it has a filesystem of its own. It does not.</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#c6e0b4" ALIGN="LEFT"><B>The abstraction</B></TD>
        <TD BGCOLOR="#e2efda" ALIGN="LEFT" BALIGN="LEFT">PersistentVolumeClaim <B>demo-data</B> (1Gi, RWO) → bound to PersistentVolume <B>pvc-94ab5278…</B><BR/><FONT POINT-SIZE="9">You wrote the claim. The provisioner created the volume and named it.</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#bdd7ee" ALIGN="LEFT"><B>The reality</B></TD>
        <TD BGCOLOR="#deebf7" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9">/var/lib/rancher/k3s/storage/pvc-94ab5278…_default_demo-data/</FONT><BR/><FONT POINT-SIZE="9">An ordinary directory, bind-mounted into the pod. No block device. No quota.</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#ffe699" ALIGN="LEFT"><B>Guest filesystem</B></TD>
        <TD BGCOLOR="#fff2cc" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="DejaVu Sans Mono">/dev/sda1</FONT> — ext4, 299 G, mounted at <FONT FACE="DejaVu Sans Mono">/</FONT><BR/><FONT POINT-SIZE="9">Every PVC on this node shares this one filesystem and its free space.</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#f8cbad" ALIGN="LEFT"><B>Virtual disk</B></TD>
        <TD BGCOLOR="#fbe5d6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="DejaVu Sans Mono">/dev/sda</FONT> — 300 GB, a ZFS zvol handed to VM 186<BR/><FONT POINT-SIZE="9"><B>Proxmox's knowledge stops here.</B> It sees one disk, never the volumes inside.</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#d9d9d9" ALIGN="LEFT"><B>Host storage</B></TD>
        <TD BGCOLOR="#f2f2f2" ALIGN="LEFT" BALIGN="LEFT">ZFS pool <B>vm-ephemeral</B> on the HP Z8's NVMe drives<BR/><FONT POINT-SIZE="9">The only layer with real redundancy — and it is below Kubernetes, invisible to it.</FONT></TD>
      </TR>
    </TABLE>
  >];

  warn [shape=plaintext, label=<
    <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#c00000" BGCOLOR="#fce4e4">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Why this matters for Redpanda</B><BR/><FONT POINT-SIZE="10">Three brokers get three PVCs — three directories on the SAME ext4 filesystem,<BR/>the SAME virtual disk, the SAME host. Raft quorum is real; the durability is not.<BR/>One disk failure loses all three replicas at once.</FONT></TD></TR>
    </TABLE>
  >];

  layers -> warn [style=invis];
}
