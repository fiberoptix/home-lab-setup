// Chapter 2, Figure 1 — one manifest, three objects, and the hash that keeps
// two generations from fighting over the same pods.
//
// Render:
//   dot -Tpng -Gdpi=150 ch02_fig1_ownership.dot -o ../images/ch02_fig1_ownership.png

digraph ownership {
  nodesep=0.12;
  ranksep=0.2;
  rankdir=TB;
  bgcolor="white";
  node  [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=12];
  graph [fontname="Helvetica", fontsize=11];

  title [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
      <TR><TD><FONT POINT-SIZE="16"><B>One manifest, three objects</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="12" COLOR="#555555">and the<BR/>pod-template-hash that lets two<BR/>generations coexist</FONT></TD></TR>
    </TABLE>>];

  // ------------------------------------------------------------- deployment
  deploy [fillcolor="#e8f0fe", color="#1a56c4", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Deployment  web</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">what you wrote. Owns the rollout strategy:<BR/>maxSurge 1 · maxUnavailable 0 ·<BR/>revisionHistoryLimit 10</FONT></TD></TR>
    </TABLE>>];

  // ----------------------------------------------------------- replicasets
  subgraph cluster_rs {
    label="  two ReplicaSets alive at once during a rollout  ";
    style="filled,rounded"; fillcolor="#fafafa"; color="#999999"; fontcolor="#555555";

    rsold [fillcolor="#ffffff", color="#888888", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>ReplicaSet  web-85cb69bbbd</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">revision 4 · replicas: 0<BR/><B>selector:</B> app=web<BR/>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<BR/><B>pod-template-hash=85cb69bbbd</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#1e8449">keeps its FULL pod template →<BR/>this is what rollout undo scales back up</FONT></TD></TR>
      </TABLE>>];

    rsnew [fillcolor="#ffffff", color="#1a56c4", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>ReplicaSet  web-8649f6f78d</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">revision 5 · replicas: 3<BR/><B>selector:</B> app=web<BR/>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<BR/><B>pod-template-hash=8649f6f78d</B></FONT></TD></TR>
      </TABLE>>];
  }

  // ----------------------------------------------------------------- pods
  pods [fillcolor="#ffffff", color="#1a56c4", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Pods</B>  (3 of them)</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">web - 8649f6f78d - 8lhkw<BR/>web - 8649f6f78d - h6fzl<BR/>web - 8649f6f78d - mw2zx</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">labels:<BR/>app=web, pod-template-hash=8649f6f78d</FONT></TD></TR>
    </TABLE>>];

  anatomy [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1a56c4" BGCOLOR="#f5f9ff">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Reading a pod name</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="12">web  -  8649f6f78d  -  8lhkw</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>web</B> = the Deployment<BR/><B>8649f6f78d</B> = pod-template-hash<BR/>— <B>the VERSION</B>,<BR/>shared by every pod of this generation<BR/><B>8lhkw</B> = random suffix — <B>the INSTANCE</B></FONT></TD></TR>
    </TABLE>>];

  // ---------------------------------------------------------------- edges
  title -> deploy [style=invis];
  deploy -> rsold [label="  scales to 0,\l  keeps template\l", color="#888888", style=dashed];
  deploy -> rsnew [label="  scales to 3", color="#1a56c4"];
  rsnew  -> pods  [label="  creates + heals", color="#1a56c4"];
  pods   -> anatomy [style=invis];

  // ownerReferences point back UP
  edge [fontsize=12, color="#1e8449", style=dotted, constraint=false];
  pods  -> rsnew  [label="  ownerReference  "];
  rsnew -> deploy [label="  ownerReference  "];

  // -------------------------------------------------------------- callout

  // constraint=true is REQUIRED here: the ownerReference edges above set
  // constraint=false as an edge default, which would otherwise let this box
  // float to the top of the drawing.
}
