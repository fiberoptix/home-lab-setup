// Chapter 3, Figure 2 — Why three brokers: the quorum arithmetic
// Render: dot -Tpng -Gdpi=150 ch03_fig2_quorum.dot -o ../images/ch03_fig2_quorum.png
digraph quorum {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=11];

  q [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10">
      <TR><TD COLSPAN="4" BGCOLOR="#1f4e79"><FONT COLOR="white" POINT-SIZE="12"><B>QUORUM = MAJORITY = floor(3/2) + 1 = 2 of 3</B></FONT></TD></TR>

      <TR>
        <TD BGCOLOR="#f2f2f2"><B>State</B></TD>
        <TD BGCOLOR="#f2f2f2"><B>Brokers up</B></TD>
        <TD BGCOLOR="#f2f2f2"><B>Can it form a majority?</B></TD>
        <TD BGCOLOR="#f2f2f2"><B>Result</B></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#e2efda" ALIGN="LEFT"><B>Healthy</B></TD>
        <TD BGCOLOR="#e2efda">3 of 3</TD>
        <TD BGCOLOR="#e2efda">yes — 3 ≥ 2</TD>
        <TD BGCOLOR="#c6e0b4" ALIGN="LEFT" BALIGN="LEFT"><B>Writes accepted</B><BR/><FONT POINT-SIZE="9">leader + 1 follower must ack</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#fff2cc" ALIGN="LEFT"><B>Lose one</B></TD>
        <TD BGCOLOR="#fff2cc">2 of 3</TD>
        <TD BGCOLOR="#fff2cc">yes — 2 ≥ 2</TD>
        <TD BGCOLOR="#ffe699" ALIGN="LEFT" BALIGN="LEFT"><B>Writes still accepted</B><BR/><FONT POINT-SIZE="9">if the dead one led a partition, a new<BR/>leader is elected in ~1 second. No data loss.</FONT></TD>
      </TR>

      <TR>
        <TD BGCOLOR="#fce4e4" ALIGN="LEFT"><B>Lose two</B></TD>
        <TD BGCOLOR="#fce4e4">1 of 3</TD>
        <TD BGCOLOR="#fce4e4">NO — 1 &lt; 2</TD>
        <TD BGCOLOR="#f8cbad" ALIGN="LEFT" BALIGN="LEFT"><B>Writes REFUSED</B><BR/><FONT POINT-SIZE="9">the survivor steps down rather than<BR/>accept writes it cannot prove are safe</FONT></TD>
      </TR>
    </TABLE>
  >];

  note [shape=plaintext, label=<
    <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#1f4e79" BGCOLOR="#eaf1f8">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>The point of the third broker</B><BR/><FONT POINT-SIZE="10">With <B>2</B> brokers, a majority is still 2 — so losing either one halts writes.<BR/>Two brokers buy you a second copy of the data and <B>zero</B> fault tolerance.<BR/><BR/><B>Odd numbers are what buy availability.</B> 3 survives 1 failure, 5 survives 2.<BR/>Going 3 → 4 costs a machine and improves nothing: a majority of 4 is 3.<BR/><BR/><FONT COLOR="#c00000"><B>Refusing writes is the correct behaviour, not a bug.</B></FONT> A minority that kept<BR/>accepting trades could not guarantee they survive — that is how you lose money.</FONT></TD></TR>
    </TABLE>
  >];

  q -> note [style=invis];
}
