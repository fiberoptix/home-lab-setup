// Chapter 3, Figure 3 — Why rpk could not reach the brokers, and how we fixed it.
//
// Render:
//   dot -Tpng -Gdpi=150 ch03_fig3_rpk_connectivity.dot -o ../images/ch03_fig3_rpk_connectivity.png

digraph rpk_connectivity {
  rankdir=TB;
  bgcolor="white";
  compound=true;
  node  [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=9];
  graph [fontname="Helvetica", fontsize=11];

  // ---------------------------------------------------------------- title
  title [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
      <TR><TD><FONT POINT-SIZE="16"><B>Reaching Redpanda from the host shell</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="10" COLOR="#555555">The advertised-listener problem, and the DNS fix that solved it</FONT></TD></TR>
    </TABLE>>];

  // ---------------------------------------------------------- the attempt
  subgraph cluster_broken {
    label="  ATTEMPT 1 — via the NodePort  (this is what failed)  ";
    style="filled,rounded"; fillcolor="#fdf2f2"; color="#c0392b"; fontcolor="#c0392b"; penwidth=1.6;

    rpk1 [fillcolor="#ffffff", color="#c0392b", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>rpk</B>  (on the host, 192.168.1.186)</TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">bootstrap = localhost:31092</FONT></TD></TR>
      </TABLE>>];

    np [fillcolor="#ffffff", color="#c0392b", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>NodePort 31092</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">svc/redpanda-external</FONT></TD></TR>
      </TABLE>>];

    meta [shape=note, fillcolor="#fff8e1", color="#b7950b", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Metadata response</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&quot;the brokers you want are:<BR/>redpanda-0.redpanda.redpanda<BR/>&nbsp;&nbsp;.svc.cluster.local:9093<BR/>redpanda-1... redpanda-2...&quot;</FONT></TD></TR>
      </TABLE>>];

    fail [shape=box, fillcolor="#c0392b", fontcolor="white", color="#7b241c", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="white"><B>dial tcp: lookup redpanda-0...</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="9">server misbehaving — the host has no<BR/>idea what *.cluster.local means</FONT></TD></TR>
      </TABLE>>];

    rpk1 -> np   [label="  1. connect, ask for metadata", color="#c0392b"];
    np   -> meta [label="  2. broker answers with its\l     ADVERTISED address\l", color="#c0392b"];
    meta -> fail [label="  3. rpk tries to resolve it", color="#c0392b"];
  }

  // ------------------------------------------------------------- the fix
  subgraph cluster_fixed {
    label="  ATTEMPT 2 — teach the host about cluster DNS  (this works)  ";
    style="filled,rounded"; fillcolor="#eafaf1"; color="#1e8449"; fontcolor="#1e8449"; penwidth=1.6;

    rpk2 [fillcolor="#ffffff", color="#1e8449", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>rpk</B>  (same host)</TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">bootstrap = the three internal FQDNs :9093</FONT></TD></TR>
      </TABLE>>];

    resolved [fillcolor="#ffffff", color="#1e8449", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>systemd-resolved</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">/etc/systemd/resolved.conf.d/<BR/>k3s-cluster-dns.conf<BR/>DNS=10.43.0.10<BR/>Domains=~cluster.local</FONT></TD></TR>
      </TABLE>>];

    coredns [fillcolor="#ffffff", color="#1e8449", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>CoreDNS</B>  10.43.0.10</TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">headless Service → per-pod A records</FONT></TD></TR>
      </TABLE>>];

    brokers [shape=box, fillcolor="#ffffff", color="#1e8449", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>The three brokers, directly</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">redpanda-0 → 10.42.0.69:9093<BR/>redpanda-1 → 10.42.0.74:9093<BR/>redpanda-2 → 10.42.0.73:9093</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#1e8449">reachable over the cni0 bridge</FONT></TD></TR>
      </TABLE>>];

    rpk2     -> resolved [label="  1. resolve *.cluster.local", color="#1e8449"];
    resolved -> coredns  [label="  2. routed to CoreDNS\l     (~ = routing-only domain)\l", color="#1e8449"];
    coredns  -> brokers  [label="  3. returns real pod IPs", color="#1e8449"];
    rpk2     -> brokers  [label="  4. connect straight to 9093\l     advertised name == dialled name\l", color="#1e8449", style=bold, constraint=false];
  }

  // ------------------------------------------------------------- caveat
  caveat [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7950b" BGCOLOR="#fffdf3">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Why this shortcut is legitimate here — and why it would not be in production</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">The host IS the Kubernetes node, so the pod network (10.42.0.0/24) sits on a local bridge and is<BR/>directly routable. From any OTHER machine on the LAN those pod IPs are unreachable and this fails.<BR/><BR/><B>The real fix</B> is to configure external.advertisedPorts / external.domain so brokers advertise an<BR/>address clients can actually reach. The general rule, and the interview answer:<BR/><B>a broker must advertise an address its clients can resolve AND route to — from where the client is.</B></FONT></TD></TR>
    </TABLE>>];

  // -------------------------------------------------------------- layout
  title -> rpk1     [style=invis];
  fail  -> rpk2     [style=invis];
  brokers -> caveat [style=invis];
}
