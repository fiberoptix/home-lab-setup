// Chapter 6, Figure 2 — what a hard kill does to each ledger, and why the
// tail of the stream is the dangerous part. Measured 3 Aug 2026.
//
// Render:
//   dot -Tpng -Gdpi=150 ch06_fig3_commit_window.dot -o ../images/ch06_fig3_commit_window.png

digraph window {
  nodesep=0.18;
  ranksep=0.32;
  rankdir=TB;
  bgcolor="white";
  node  [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=11];
  graph [fontname="Helvetica", fontsize=11];

  title [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
      <TR><TD><FONT POINT-SIZE="16"><B>The commit window, and who pays for it</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="11" COLOR="#555555">SIGKILL between the state write and the offset commit</FONT></TD></TR>
    </TABLE>>];

  seq [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7f8c8d" BGCOLOR="#fbfbfb">
      <TR><TD ALIGN="LEFT"><B>per record</B></TD><TD ALIGN="LEFT"><B>gateway (autocommit)</B></TD><TD ALIGN="LEFT"><B>fills (transaction)</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Courier">apply</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#c0392b">durable NOW, cannot be undone</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#1e8449">staged, not yet durable</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Courier">every 50 recs<BR/>or 5 seconds</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#555555">nothing to do &#8212; already written</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11"><FONT FACE="Courier">db.commit()</FONT> then <FONT FACE="Courier">c.commit()</FONT></FONT></TD></TR>
    </TABLE>>];

  // ------------------------------------------------------- crash
  subgraph cluster_crash {
    label="  SIGKILL arrives mid-batch  ";
    style="filled,rounded"; fillcolor="#fdf2f2"; color="#c0392b"; fontcolor="#c0392b"; penwidth=1.6;

    crash [fillcolor="#ffffff", color="#c0392b", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">11 fills applied since the last commit.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#1e8449"><B>fills</B>: transaction never committed &#8594; <B>rolled back</B>.<BR/>State and offset are back in lockstep.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#c0392b"><B>gateway</B>: 11 calls already durable.<BR/>Nothing to roll back. No record that they happened.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">lastState: Error:137   (128 + SIGKILL)</FONT></TD></TR>
      </TABLE>>];
  }

  // ------------------------------------------------------- replay
  subgraph cluster_replay {
    label="  the successor resumes from the last COMMITTED offset  ";
    style="filled,rounded"; fillcolor="#eef5fc"; color="#2471a3"; fontcolor="#2471a3"; penwidth=1.6;

    replay [fillcolor="#ffffff", color="#2471a3", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">The same 11 fills are delivered again.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#1e8449"><B>fills</B>: <FONT FACE="Courier">ON CONFLICT DO UPDATE</FONT> overwrites the same<BR/>11 rows. Total unchanged. <B>Effectively once.</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#c0392b"><B>gateway</B>: 11 <I>more</I> calls. 8011 for 8000 real fills.<BR/><B>1100 shares executed that nobody ordered.</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#555555">Reassignment waits out <FONT FACE="Courier">session.timeout.ms</FONT> (~45s):<BR/>a hard-dead member is only noticed by missed heartbeats.</FONT></TD></TR>
      </TABLE>>];
  }

  // ------------------------------------------------------- the tail bug
  tail [fillcolor="#fef9e7", color="#b7950b", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>The bug that made it repeat forever</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">The first version committed on <B>record count only</B>. On an idle<BR/>topic the last partial batch never reaches 50, so it is <B>never<BR/>committed</B>. Lag stuck at <FONT FACE="Courier">13</FONT> and stayed there indefinitely.</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#c0392b">That permanently-uncommitted tail is replayed on <B>every</B><BR/>restart: duplicates went <FONT FACE="Courier">11 &#8594; 22 &#8594; 33</FONT>, compounding.</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#1e8449">Fix: commit on <B>count OR elapsed time</B>. Lag went to 0 and held.</FONT></TD></TR>
    </TABLE>>];

  title  -> seq [style=invis];
  seq    -> crash [style=invis];
  crash  -> replay [color="#c0392b", style=bold, label="  redelivery  "];
  replay -> tail [style=invis];
}
