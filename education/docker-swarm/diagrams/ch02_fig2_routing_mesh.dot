// Chapter 2, Figure 2 - the routing mesh: every node answers on a published port,
// whether or not it runs a task for that service.
digraph mesh {
    rankdir=TB;
    bgcolor="white";
    node [fontname="Helvetica" fontsize=11 shape=box style="filled,rounded" fillcolor="#f5f5f5" color="#888888"];
    edge [fontname="Helvetica" fontsize=10 color="#666666"];
    graph [fontname="Helvetica" fontsize=11];

    client [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>curl / browser</B><BR/>hits ANY node on :5002</TD></TR></TABLE>>
            fillcolor="#e8eef7" color="#4a6fa5"];

    p1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-1 :5002</B><BR/><I>NO backend task</I></TD></TR></TABLE>>];
    p2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-2 :5002</B></TD></TR></TABLE>>];
    p3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-3 :5002</B></TD></TR></TABLE>>];

    ing [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>ingress overlay network</B> — 10.0.0.0/24<BR/>IPVS load balancer on every node<BR/><I>mode: ingress in the stack file</I></TD></TR></TABLE>>
          fillcolor="#e8f7ee" color="#3a8a5a"];

    t1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">backend task 1<BR/><I>on swarm-2</I></TD></TR></TABLE>>];
    t2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">backend task 2<BR/><I>on swarm-3</I></TD></TR></TABLE>>];

    client -> p1;
    client -> p2;
    client -> p3;
    p1 -> ing;
    p2 -> ing;
    p3 -> ing;
    ing -> t1;
    ing -> t2;

    {rank=same; p1; p2; p3;}
    {rank=same; t1; t2;}
}
