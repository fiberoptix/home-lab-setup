// Chapter 3, Figure 1 - three ways in, and only two of them are redundant.
// Point of the figure: the control plane is HA and user traffic is HA, but the DELIVERY path
// was a single IP - and the node it named was also the node the database was pinned to.
// Labels are deliberately terse: the reasoning lives in the chapter prose under the figure,
// where it renders at body size instead of being rasterised (see CONVENTIONS.md).
digraph delivery {
    rankdir=TB;
    bgcolor="white";
    node [fontname="Helvetica" fontsize=11 shape=box style="filled,rounded" fillcolor="#f5f5f5" color="#888888"];
    edge [fontname="Helvetica" fontsize=11 color="#666666"];
    graph [fontname="Helvetica" fontsize=11 ranksep=0.5 nodesep=0.35];

    users [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Users</B><BR/>:5001</TD></TR></TABLE>>
           fillcolor="#e8f7ee" color="#3a8a5a"];

    runner [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>GitLab runner job</B><BR/>ssh · scp · deploy</TD></TR></TABLE>>
            fillcolor="#e8eef7" color="#4a6fa5"];

    s1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-1</B> · .191<BR/>manager<BR/><B>postgres PINNED</B></TD></TR></TABLE>>
        fillcolor="#f7e8e8" color="#b03030"];
    s2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-2</B> · .192<BR/>manager</TD></TR></TABLE>>];
    s3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-3</B> · .193<BR/>manager</TD></TR></TABLE>>];

    raft [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Raft</B> · quorum 2 of 3</TD></TR></TABLE>>
          fillcolor="#e8f7ee" color="#3a8a5a"];

    users -> s1 [color="#3a8a5a"];
    users -> s2 [label="  mesh  " color="#3a8a5a" fontcolor="#3a8a5a"];
    users -> s3 [color="#3a8a5a"];

    runner -> s1 [label="  BEFORE  \l  one IP  \l" color="#b03030" fontcolor="#b03030" penwidth=2];
    runner -> s2 [label="  AFTER  \l  probe each  \l" style=dashed color="#4a6fa5" fontcolor="#4a6fa5"];
    runner -> s3 [style=dashed color="#4a6fa5"];

    s1 -> raft [dir=none color="#3a8a5a"];
    s2 -> raft [dir=none color="#3a8a5a"];
    s3 -> raft [dir=none color="#3a8a5a"];

    {rank=same; users; runner;}
    // Force left-to-right .191/.192/.193 order. Without this, dot minimises edge crossings and
    // reorders the nodes, which reads as an error when the prose refers to them by address.
    {rank=same; s1 -> s2 -> s3 [style=invis];}
}
