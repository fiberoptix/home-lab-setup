// Chapter 3, Figure 2 - why a rebooted manager can depose a leader it can never replace.
// Point of the figure: TERM and INDEX are different axes. swarm-3 returned highest in term
// (authority) and lowest in index (data), and each axis has the OPPOSITE consequence.
// The loop is drawn closed on purpose: it repeats every ~20s and TERMINATES BY ITSELF.
//
// Layout note, learned the hard way: the build scales every figure to the full 7in column, so the
// RAW aspect ratio sets the rendered font size. This chain as one column came out 5.0x6.2in (8.7in
// tall when scaled - overflows the page); as one row, 18in wide (4.2pt text, unreadable); with long
// labels, 9.9in (7.8pt). Two steps per rank AND terse labels put it near 7in, so text stays ~11pt.
// Every word trimmed from here is argued in the prose instead, at body size. See CONVENTIONS.md.
digraph term_inflation {
    rankdir=TB;
    bgcolor="white";
    node [fontname="Helvetica" fontsize=11 shape=box style="filled,rounded" fillcolor="#f5f5f5" color="#888888"];
    edge [fontname="Helvetica" fontsize=11 color="#666666"];
    graph [fontname="Helvetica" fontsize=11 ranksep=0.45 nodesep=0.35];

    stale [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-3 reboots</B><BR/>term <B>31</B> · index <B>743</B></TD></TR></TABLE>>
           fillcolor="#f7e8e8" color="#b03030"];

    depose [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>leader stands down</B><BR/><FONT COLOR="#b03030">cancels all waits</FONT></TD></TR></TABLE>>
            fillcolor="#f7e8e8" color="#b03030"];

    reject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>vote refused</B><BR/>743 &lt; 775</TD></TR></TABLE>>
            fillcolor="#e8eef7" color="#4a6fa5"];

    reelect [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>swarm-1 re-elected</B></TD></TR></TABLE>>
             fillcolor="#e8eef7" color="#4a6fa5"];

    settled [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>silenced, term 34</B><BR/>~2.5 min, no action</TD></TR></TABLE>>
             fillcolor="#e8f7ee" color="#3a8a5a"];

    stale   -> depose  [label="  term  " color="#b03030" fontcolor="#b03030" penwidth=2];
    depose  -> reject  [label="  campaigns  "];
    reject  -> reelect [label="  index  " color="#4a6fa5" fontcolor="#4a6fa5"];
    reelect -> stale   [label="  +1 term  " color="#b03030" fontcolor="#b03030"
                        style=dashed constraint=false];
    reelect -> settled [label="  ends itself  " color="#3a8a5a" fontcolor="#3a8a5a" penwidth=2];

    // Only ONE pair shares a rank. Putting reelect+settled side by side too made the widest row
    // 1283px, which figcheck rejects: scaled to the 7in box that rasterises the labels at 9.0pt,
    // under the 10pt floor. Narrower and taller is the right trade here.
    {rank=same; depose; reject;}
}
