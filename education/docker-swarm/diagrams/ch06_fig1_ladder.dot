// Chapter 6, Figure 1 - the ladder of questions. Each rung answers only its own contract.
// Point of the figure: Swarm's contract ends at "the container started", and every drill in the
// phase was an instance of reading a lower rung as an answer to a higher one.
digraph ladder {
    rankdir=BT;
    bgcolor="white";
    node [fontname="Helvetica" fontsize=11 shape=box style="filled,rounded" fillcolor="#f5f5f5" color="#888888" width=3.85];
    edge [fontname="Helvetica" fontsize=11 color="#666666" arrowhead=none];
    graph [fontname="Helvetica" fontsize=11];

    r1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Did the manager accept the spec?</B>  &#8592; exit code 0</TD></TR></TABLE>>];
    r2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Do N tasks exist?</B>  &#8592; service ls, N/N</TD></TR></TABLE>>];
    r3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Was my change applied or refused?</B>  &#8592; UpdateStatus</TD></TR></TABLE>>];
    r4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Is the process alive?</B>  &#8592; task Running, container Up</TD></TR></TABLE>>
         fillcolor="#e8eef7" color="#4a6fa5"];
    r5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Is the service internally sane?</B>  &#8592; healthcheck<BR/><I>the highest rung Swarm can ACT on</I></TD></TR></TABLE>>
         fillcolor="#e8f7ee" color="#3a8a5a"];
    r6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Ready for business?</B>  &#8592; a request that hits its dependencies</TD></TR></TABLE>>
         fillcolor="#f7f0e8" color="#a5794a"];
    r7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Is EVERY entry point right?</B>  &#8592; one assertion per port<BR/><I>the rung a wrong-but-running image lives on</I></TD></TR></TABLE>>
         fillcolor="#f7f0e8" color="#a5794a"];
    r8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Can users do what they came to do?</B><BR/><I>nothing below this line has an opinion</I></TD></TR></TABLE>>
         fillcolor="#f7e8e8" color="#b03030"];

    r1 -> r2 -> r3 -> r4 -> r5 -> r6 -> r7 -> r8;

    edge [style=dashed color="#b03030" fontcolor="#b03030" arrowhead=normal constraint=false];
    r4 -> r8 [label="  the error in every drill:\l  a task-level answer to an\l  app-level question\l"];
}
