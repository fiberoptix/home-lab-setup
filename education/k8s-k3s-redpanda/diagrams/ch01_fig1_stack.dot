// Chapter 1, Figure 1 — Where k3s sits in the home lab
// Render: dot -Tpng -Gdpi=150 ch01_fig1_stack.dot -o ../images/ch01_fig1_stack.png
digraph stack {
  rankdir=TB;
  bgcolor="white";
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=11];

  subgraph cluster_pve {
    label=<<B>PHYSICAL HOST</B> — HP Z8 G4 "fable"<BR ALIGN="LEFT"/>2× Xeon Platinum 8168 (48c/96t) · 128 GB RAM · Proxmox VE 9.2.4>;
    labeljust="l";
    fontsize=12;
    style="filled,rounded";
    fillcolor="#f0f0f0";
    color="#999999";
    margin=16;

    node [shape=box, style="filled,rounded", fillcolor="#ffffff", color="#bbbbbb", height=0.7];

    vm181 [label="VM 181\nGitLab\n.181"];
    vm182 [label="VM 182\nRunner\n.182"];
    vm183 [label="VM 183\nSonarQube\n.183"];
    vm184 [label="VM 184\nWWW\n.184"];
    vm186 [label="VM 186\nvm-k8-redpanda-1\n.186", fillcolor="#1f4e79", fontcolor="white", color="#1f4e79", penwidth=2];
    vm180 [label="VM 180\nQA\n.180"];

    {rank=same; vm181; vm182; vm183;}
    {rank=same; vm184; vm186; vm180;}
    vm181 -> vm182 -> vm183 [style=invis];
    vm184 -> vm186 -> vm180 [style=invis];
    vm181 -> vm184 [style=invis];
  }

}
