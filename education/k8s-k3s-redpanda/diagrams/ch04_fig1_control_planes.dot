// Chapter 4, Figure 1 — the boundary between the Kubernetes control plane and
// the Redpanda control plane, and the gap that falls between them.
// Verified on vm-k8-redpanda-1, 3 Aug 2026.
//
// Render:
//   dot -Tpng -Gdpi=150 ch04_fig1_control_planes.dot -o ../images/ch04_fig1_control_planes.png

digraph control_planes {
  nodesep=0.15;
  ranksep=0.26;
  rankdir=TB;
  bgcolor="white";
  node  [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=11];
  graph [fontname="Helvetica", fontsize=11];

  title [shape=plaintext, style="", fillcolor="none", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
      <TR><TD><FONT POINT-SIZE="16"><B>Two control planes, and the gap between them</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="11" COLOR="#555555">Helm can build the brokers. It cannot create a topic.</FONT></TD></TR>
    </TABLE>>];

  // ============================================ KUBERNETES SIDE
  subgraph cluster_k8s {
    label="  KUBERNETES control plane  —  declared in Git, reconciled forever  ";
    style="filled,rounded"; fillcolor="#eaf2fb"; color="#1f618d"; fontcolor="#1f618d"; penwidth=1.6;

    k8s [fillcolor="#ffffff", color="#1f618d", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>redpanda-values.yaml  →  Helm  →  StatefulSet</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">how many brokers &#183; CPU &#183; memory &#183; PVC size<BR/>StorageClass &#183; listeners &#183; TLS &#183; the broker config file</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#1f618d">reconciled continuously: kill a pod and it comes back</FONT></TD></TR>
      </TABLE>>];

    k8sout [fillcolor="#1f618d", fontcolor="white", color="#154360", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="white"><B>3 pods Running &#183; 2/2 Ready &#183; Healthy: true</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11">every Kubernetes signal is green</FONT></TD></TR>
      </TABLE>>];

    k8s -> k8sout [color="#1f618d"];
  }

  // ============================================ THE GAP
  gap [fillcolor="#fdf2f2", color="#c0392b", penwidth=1.8, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#c0392b"><B>THE GAP &#8212; nothing owns this</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" FACE="Courier">$ rpk topic produce orders<BR/>UNKNOWN_TOPIC_OR_PARTITION<BR/>exit=1</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">Infrastructure green. Service unusable.<BR/><B>kubectl get topics</B> returns nothing &#8212; no such object exists.</FONT></TD></TR>
    </TABLE>>];

  // ============================================ REDPANDA SIDE
  subgraph cluster_rp {
    label="  REDPANDA control plane  —  data inside the app, invisible to kubectl  ";
    style="filled,rounded"; fillcolor="#eafaf1"; color="#1e8449"; fontcolor="#1e8449"; penwidth=1.6;

    rp [fillcolor="#ffffff", color="#1e8449", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>Kafka admin protocol  →  controller Raft group</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">topics &#183; partitions per topic &#183; replication factor<BR/>retention &#183; ACLs &#183; users &#183; quotas &#183; consumer groups</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#1e8449">requires a RUNNING, HEALTHY cluster to accept the call</FONT></TD></TR>
      </TABLE>>];

    disk [fillcolor="#ffffff", color="#1e8449", shape=cylinder, style="filled", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">redpanda/controller/0_0<BR/>on datadir-redpanda-{0,1,2}</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">survives: Job deletion, pod restart, full shutdown<BR/><B>destroyed by: deleting the PVCs</B></FONT></TD></TR>
      </TABLE>>];

    rp -> disk [color="#1e8449", label=" replicated by Raft "];
  }

  k8sout -> gap [style=invis];
  gap -> rp [color="#c0392b", style=bold, label="  a post-deploy step must cross this line  "];

  title -> k8s [style=invis];
}
